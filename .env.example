# Copy to .env for LOCAL runs only:  cp .env.example .env
# `npm run dev` reads this via Node's native --env-file.
#
# This file is the LOCAL (optional DEV) config. The deployed environments
# (STAGING, PROD-AU, PROD-EU) do NOT use this file — each VM has its own
# /srv/notes-api/shared/.env with that environment's real values (DB endpoints,
# secrets, REGION). Config is read at runtime; it is never baked into the
# artifact. See DEPLOYMENT.md.

PORT=3000

# Local Postgres — install locally, or point at a shared, non-production dev DB.
DATABASE_URL=postgres://notes:notes@localhost:5432/notes

# Set to "true" against managed Postgres that requires TLS.
PGSSL=false

# Locally we let the app migrate on boot for convenience. On the VMs this is set
# to "false" — the deploy step (scripts/deploy-release.sh) owns migrations so PM2
# cluster workers never race.
RUN_MIGRATIONS_ON_BOOT=true

# Region tag (read per-VM in deployed envs; "local" here).
REGION=local
